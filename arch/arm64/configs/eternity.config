# BPF
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_DM_SNAPSHOT=y
CONFIG_DUMMY=y
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16
CONFIG_BLK_CGROUP=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_BLU_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_Runutil=y
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y

# Samsung Security
# CONFIG_GAF is not set
# CONFIG_GAF_V6 is not set
# CONFIG_SECURITY_DSMS is not set

# Enable 32-bit VDSO
CONFIG_KUSER_HELPERS=y
CONFIG_COMPAT_VDSO=y

# CONFIG_KPROBES is not set
CONFIG_OVERLAY_FS=y

# Enable BinderFS
CONFIG_ANDROID_BINDERFS=y

# Enable CGroup support
CONFIG_BLK_CGROUP=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_BFQ_GROUP_IOSCHED=y

# IncrementalFS
CONFIG_INCREMENTAL_FS=y

# Wireguard
CONFIG_WIREGUARD=y

# CMDLine spoof
CONFIG_PROC_SPOOF_CMDLINE=y

# SEC Memory Management
CONFIG_SEC_MM=y

#power suspend and state notifier
CONFIG_POWERSUSPEND=y
CONFIG_POWERSUSPEND_DEBUG=n
CONFIG_STATE_NOTIFIER=y

#Dynamic FSync 2.0
CONFIG_DYNAMIC_FSYNC=y

#kernelspace battery saver mode
CONFIG_BATTERY_SAVER=y

#Boeffla generic wakelock blocker driver
CONFIG_BOEFFLA_WL_BLOCKER=y

#DTS eagle
CONFIG_AINUR_DTS_SW=y

#Anxiety as default
CONFIG_IOSCHED_MAPLE=y
CONFIG_IOSCHED_ANXIETY=y
CONFIG_DEFAULT_ANXIETY=y
CONFIG_DEFAULT_IOSCHED="anxiety"
CONFIG_DEFAULT_CFQ=n
CONFIG_DEFAULT_MAPLE=n
CONFIG_MQ_IOSCHED_DEADLINE=n
CONFIG_MQ_IOSCHED_KYBER=n

# R48P0 GPU Driver
CONFIG_MALI_BIFROST_R48P0=y
# CONFIG_MALI_EXYNOS_INTERACTIVE_BOOST is not set
# CONFIG_MALI_EXYNOS_DEBUG_FAULT_DUMP is not set
CONFIG_MALI_PRFCNT_SET_PRIMARY=y
# CONFIG_MALI_PRFCNT_SET_TERTIARY is not set
# CONFIG_MALI_ARBITRATION is not set

#OC & UC
CONFIG_ARM_MODCLOCK=y
CONFIG_MAX_FREQ_BIG=2400000
CONFIG_MIN_FREQ_BIG=377000
CONFIG_MAX_FREQ_LITTLE=1950000
CONFIG_MIN_FREQ_LITTLE=182000
CONFIG_MAX_FREQ_PRIME=2808000
CONFIG_MIN_FREQ_PRIME=520000

#FP BOOSTER
CONFIG_FINGERPRINT_BOOST=y

#Loadable Kernel Module support
CONFIG_MODULES=y
CONFIG_MODULE_FORCE_LOAD=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=n
CONFIG_MODULE_SIG=n
CONFIG_MODULE_COMPRESS=n
CONFIG_TRIM_UNUSED_KSYMS=n
CONFIG_HZ_300=y

# Miscellaneous M62 configs
# CONFIG_DEFERRED_INITCALLS is not set
# CONFIG_ARM64_ERRATUM_843419 is not set
# CONFIG_PCIE_IOMMU_HISTORY_LOG is not set
# CONFIG_KSM is not set
CONFIG_NET_UDP_TUNNEL=y

# Set the minimum block dev loop count to 16 (https://github.com/aosp-mirror/kernel_common/commit/dd5d3e98d0ae393120dfe412cf6b4e5363cec920)
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16

# Enable power efficient workqueues
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# Enable PSI
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set

# Disable In-Kernel LMK
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set

# Disable CGroup pressure (https://github.com/aosp-mirror/kernel_common/commit/cda79c474cf1d2fc622c265fea75d43ff840afa6)
# And set androidboot.boot_devices
CONFIG_CMDLINE="androidboot.boot_devices=13d60000.ufs cgroup_disable=pressure"

# Enable Samsung Memory Management additions
CONFIG_SEC_MM=y

# Set the minimum block dev loop count to 16 (https://github.com/aosp-mirror/kernel_common/commit/dd5d3e98d0ae393120dfe412cf6b4e5363cec920)
CONFIG_BLK_DEV_LOOP_MIN_COUNT=16

# Disable reundant debugging
# CONFIG_SLUB_DEBUG is not set
# CONFIG_KPROBES is not set

# Miscellaneous M62 configs
# CONFIG_DEFERRED_INITCALLS is not set
# CONFIG_ARM64_ERRATUM_843419 is not set
# CONFIG_PCIE_IOMMU_HISTORY_LOG is not set
# CONFIG_KSM is not set
CONFIG_NET_UDP_TUNNEL=y

# Enable misc kernel features
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_BOEFFLA_WL_BLOCKER=y

## FRANDOM
CONFIG_FRANDOM=y

# EOF
